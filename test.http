@hostname = localhost
@port = 7071
@host = {{hostname}}:{{port}}
@contentType = application/json


POST  http://{{host}}/api/call_openai?question=Summerize the Corvus document only return the json object
content-type: {{contentType}}


###

POST http://{{host}}/api/call_openai?question=chaange to a cvs output
content-type: {{contentType}}

[
  {
    "Role": "system",
    "Text": "Summarise the document into the following columns : Disease area or tech platform, Company name, asset name, target/pathway, Mechanism of action and indication, Stage of development, Available data (preclinical models, tox studies,     clinical data etc), IP, patent applications, LOE, Partnering interests (structure, regions), Any additional background on the molecule (re-positioning etc) , Third party obligations, Predicted launch. Return in a JSON."
  },
  {
    "Role": "user",
    "Text": "Summerize the Corvus document only return the json object"
  },
  {
    "Role": "assistant",
    "Text": "```json\n{\n  \"Disease area or tech platform\": \"Oncology/Immuno-Oncology\",\n  \"Company name\": \"Corvus Pharmaceuticals\",\n  \"Asset name\": \"CPI-818\",\n  \"Target/pathway\": \"ITK (Interleukin-2-inducible T-cell kinase)\",\n  \"Mechanism of action and indication\": \"CPI-818 is an oral small molecule designed to inhibit ITK and modulate T-cell receptor signaling to treat T-cell lymphomas and other cancers.\",\n  \"Stage of development\": \"Phase 1/1b\",\n  \"Available data\": \"Preclinical models, early clinical data\",\n  \"IP, patent applications, LOE\": \"Multiple patents filed, specific details not provided\",\n  \"Partnering interests (structure, regions)\": \"Open to collaborations, especially in regions outside the US\",\n  \"Any additional background on the molecule\": \"CPI-818 is being evaluated for potential in other T-cell-mediated diseases beyond oncology\",\n  \"Third party obligations\": \"None disclosed\",\n  \"Predicted launch\": \"2025 (tentative)\"\n}\n```"
  }
]

